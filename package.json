{
  "name": "openpdf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run assets && vite --host 127.0.0.1 --port 1420",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
